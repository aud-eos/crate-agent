// Interface definition for the Rust core, consumed by Swift via uniffi.
//
// As features land, new types and functions are declared here; uniffi
// generates the Swift bindings during the build step.

namespace crate_agent_core {
  // Liveness check used by the Swift app at startup to verify the Rust
  // core is linked and callable. Returns the core's version string.
  string core_version();

  // Read a Serato `.crate` file from disk and return every track path
  // it references (the UTF-16BE-decoded `ptrk` field inside each
  // `otrk` container).
  [Throws=CoreError]
  sequence<string> read_crate_paths(string crate_path);

  // Rewrite every `otrk → ptrk` entry in the given `.crate` file whose
  // current value equals `old_path`, replacing it with `new_path`.
  // Writes the file back if any replacements were made. Returns the
  // number of paths that were rewritten.
  [Throws=CoreError]
  u32 rewrite_crate_path(string crate_path, string old_path, string new_path);

  // Read a Serato `database V2` file from disk and return every track
  // path it references (the UTF-16BE-decoded `pfil` field inside each
  // `otrk` container).
  [Throws=CoreError]
  sequence<string> read_database_paths(string database_path);

  // Rewrite every `otrk → pfil` entry in the given `database V2` file
  // whose current value equals `old_path`, replacing it with `new_path`.
  // Writes the file back if any replacements were made. Returns the
  // number of paths that were rewritten. Preserves all other per-track
  // metadata (artist, title, BPM, beatgrid references, etc.) byte-exact.
  [Throws=CoreError]
  u32 rewrite_database_path(string database_path, string old_path, string new_path);

  // Number of `otrk` entries in a `database V2` file. Useful for
  // progress reporting on full library scans.
  [Throws=CoreError]
  u32 database_track_count(string database_path);

  // Read a Serato `database V2` file and return full track metadata
  // records — path plus the well-known `t*` text fields (artist,
  // title, album, genre, BPM, key, comment, length, label). Used by
  // the Serato-exit reload flow to mirror Serato metadata changes
  // into crate-agent's DB.
  [Throws=CoreError]
  sequence<SeratoTrackRecord> read_database_records(string database_path);

  // Decode an audio file and return its Chromaprint perceptual
  // fingerprint as a sequence of 32-bit hashes. Stable across
  // re-encodings of the same recording within Chromaprint's tolerance.
  [Throws=CoreError]
  sequence<u32> fingerprint_audio_file(string file_path);

  // Read metadata tags and audio properties from an audio file. All
  // text fields are optional — real-world files often have partial
  // metadata. duration_seconds is populated from audio properties
  // regardless of whether the file carries tags.
  [Throws=CoreError]
  AudioTags read_audio_tags(string file_path);
};

// Full track-level metadata extracted from a Serato `database V2`
// entry. `path` is required (an otrk without `pfil` is useless and
// gets dropped before the FFI boundary); every other field is
// present when the corresponding `t*` tag exists in the otrk and
// decodes as valid UTF-16BE.
//
// `bpm`, `length` and other numeric-ish fields are exposed as
// strings because Serato stores them as strings (e.g. "128.000",
// "03:24"). Lossless on the FFI boundary; callers parse as needed.
dictionary SeratoTrackRecord {
  string path;
  string? artist;
  string? title;
  string? album;
  string? genre;
  string? bpm;
  string? key;
  string? comment;
  string? length;
  string? label;
};

dictionary AudioTags {
  string? title;
  string? artist;
  string? album;
  string? album_artist;
  string? genre;
  u32? year;
  u32? track_number;
  u32? total_tracks;
  f64? bpm;
  string? comment;
  u64? duration_seconds;
};

// Strongly-typed error surface for Rust → Swift error propagation.
// `interface`-style errors carry per-variant data, so error messages
// survive the FFI boundary instead of being reduced to a bare name.
[Error]
interface CoreError {
  NotImplemented();
  InvalidInput(string reason);
  IoError(string message);
  SeratoFormat(string message);
  Fingerprint(string message);
  Tag(string message);
};

// Interface definition for the Rust core, consumed by Swift via uniffi.
//
// As features land, new types and functions are declared here; uniffi
// generates the Swift bindings during the build step.

namespace crate_agent_core {
  // Liveness check used by the Swift app at startup to verify the Rust
  // core is linked and callable. Returns the core's version string.
  string core_version();

  // Read a Serato `.crate` file from disk and return every track path
  // it references (the UTF-16BE-decoded `ptrk` field inside each
  // `otrk` container).
  [Throws=CoreError]
  sequence<string> read_crate_paths(string crate_path);

  // Rewrite every `otrk → ptrk` entry in the given `.crate` file whose
  // current value equals `old_path`, replacing it with `new_path`.
  // Writes the file back if any replacements were made. Returns the
  // number of paths that were rewritten.
  [Throws=CoreError]
  u32 rewrite_crate_path(string crate_path, string old_path, string new_path);

  // Read a Serato `database V2` file from disk and return every track
  // path it references (the UTF-16BE-decoded `pfil` field inside each
  // `otrk` container).
  [Throws=CoreError]
  sequence<string> read_database_paths(string database_path);

  // Rewrite every `otrk → pfil` entry in the given `database V2` file
  // whose current value equals `old_path`, replacing it with `new_path`.
  // Writes the file back if any replacements were made. Returns the
  // number of paths that were rewritten. Preserves all other per-track
  // metadata (artist, title, BPM, beatgrid references, etc.) byte-exact.
  [Throws=CoreError]
  u32 rewrite_database_path(string database_path, string old_path, string new_path);

  // Bulk variant: apply every rename in `renames` to `database V2` in
  // one read + one write. Reports the number of otrks rewritten (an
  // otrk matching a rename in the batch counts once) and each rename
  // whose record is not at its final path afterwards. For an
  // Organize batch moving N tracks, this collapses N full reads + N
  // full writes of a multi-MB file into one of each.
  [Throws=CoreError]
  SeratoBatchWriteResult batch_rewrite_database_paths(
    string database_path,
    sequence<SeratoPathRename> renames
  );

  // Bulk variant of `rewrite_crate_path`. Same semantics applied
  // per-crate-file — one read + one write of the crate file regardless
  // of how many renames apply within it.
  [Throws=CoreError]
  u32 batch_rewrite_crate_paths(
    string crate_path,
    sequence<SeratoPathRename> renames
  );

  // Remove every `otrk` from `database V2` whose `pfil` matches
  // `track_path`. Used by crate-agent's duplicate-resolver after
  // the file has been trashed so Serato doesn't show a broken
  // reference. Other otrks (and non-otrk records like vrsn) are
  // preserved byte-exact. Returns the number of otrks dropped.
  //
  // Same SeratoWatchdog gating as update/add — Serato must NOT be
  // running. Otherwise Serato overwrites the file from its in-memory
  // cache, undoing the removal.
  [Throws=CoreError]
  u32 remove_track_from_database(string database_path, string track_path);

  // Remove every `otrk` from the given `.crate` file whose `ptrk`
  // matches `track_path`. Sweep this across every `.crate` in the
  // Subcrates directory to fully de-register a deleted file.
  // Returns the number of entries removed from this one file.
  [Throws=CoreError]
  u32 remove_path_from_crate(string crate_path, string track_path);

  // Number of `otrk` entries in a `database V2` file. Useful for
  // progress reporting on full library scans.
  [Throws=CoreError]
  u32 database_track_count(string database_path);

  // Read a Serato `database V2` file and return full track metadata
  // records — path plus the well-known `t*` text fields (artist,
  // title, album, genre, BPM, key, comment, length, label). Used by
  // the Serato-exit reload flow to mirror Serato metadata changes
  // into crate-agent's DB.
  [Throws=CoreError]
  sequence<SeratoTrackRecord> read_database_records(string database_path);

  [Throws=CoreError]
  sequence<SeratoTrackRecord> read_database_records_strict(string database_path);

  // Update Serato's metadata for a single track inside `database V2`.
  // For each `Some(...)` field in `update`, the corresponding `t*`
  // record in the matching `otrk` is set (creating it if absent);
  // `None` fields leave the existing record alone. Returns 1 if the
  // matching otrk was found and updated, 0 otherwise. Writes the
  // file back if any update happened.
  //
  // Must be called only while Serato is NOT running — Serato caches
  // its library in memory and overwrites the disk version on save.
  // The Swift caller gates this via SeratoWatchdog.
  [Throws=CoreError]
  u32 update_database_record(
    string database_path,
    string track_path,
    SeratoMetadataUpdate update
  );

  // Bulk variant of `update_database_record`. One file read + one
  // file write regardless of how many tracks are updated — the write-
  // side twin of `batch_rewrite_database_paths`. Used by the SP-2
  // Auto-Tag apply, which confirms many MusicBrainz matches at once;
  // each would otherwise read+rewrite the multi-MB file on its own.
  // Reports the number of otrks actually changed and each requested
  // path with no record.
  //
  // Same SeratoWatchdog gating as update_database_record.
  [Throws=CoreError]
  SeratoBatchWriteResult batch_update_database_records(
    string database_path,
    sequence<SeratoTrackMetadataUpdate> updates
  );

  // Append a new track to Serato's `database V2`. Used by crate-
  // agent's drag-drop import flow to register a file with Serato
  // without going through Serato's own UI. Returns 1 if the track
  // was added, 0 if Serato already has it. Writes the file back if
  // an add happened.
  //
  // Same SeratoWatchdog gating as update_database_record.
  [Throws=CoreError]
  u32 add_track_to_database(
    string database_path,
    string track_path,
    SeratoMetadataUpdate metadata
  );

  // Decode an audio file and return its Chromaprint perceptual
  // fingerprint as a sequence of 32-bit hashes. Stable across
  // re-encodings of the same recording within Chromaprint's tolerance.
  [Throws=CoreError]
  sequence<u32> fingerprint_audio_file(string file_path);

  // Encode a raw Chromaprint fingerprint (as returned by
  // fingerprint_audio_file) into the compressed, base64url string
  // AcoustID's lookup API expects -- the same wire format fpcalc's
  // FINGERPRINT= line emits.
  string encode_fingerprint(sequence<u32> raw);

  // Read metadata tags and audio properties from an audio file. All
  // text fields are optional — real-world files often have partial
  // metadata. duration_seconds is populated from audio properties
  // regardless of whether the file carries tags.
  [Throws=CoreError]
  AudioTags read_audio_tags(string file_path);

  // Write metadata tags into the audio file at `file_path`. Each
  // field in `update` is independently optional: `null` leaves the
  // existing tag value alone; a value (including the empty string)
  // overwrites the tag. For MP3 the write is **ID3v2.4** with
  // ID3v1 stripped; FLAC writes Vorbis comments; M4A writes iTunes
  // atoms. Fields with no equivalent in a given tag format (e.g.,
  // BPM in WAV's RIFF INFO) are silently skipped — write succeeds
  // and the file's other fields land normally.
  //
  // Called from the hygiene runner after `setMetadata` +
  // `commitMetadataToSerato`, under the same batch_id, so a single
  // Undo on the History view reverts the file tags alongside the
  // Serato and crate-agent DB writes.
  [Throws=CoreError]
  void write_audio_tags(string file_path, AudioTagUpdate update);
};

// One rename pair in a `batch_rewrite_*` call. Both paths are
// Serato-relative (the `Music/...` form Serato itself stores).
dictionary SeratoPathRename {
  string old_path;
  string new_path;
};

// What a `database V2` batch write did. `unmatched_paths` names each
// requested path whose track the library does not hold afterwards (for a
// rename, the requested old path), so "nothing to change" is
// distinguishable from "no such track" (#105).
dictionary SeratoBatchWriteResult {
  u32 rewritten_count;
  sequence<string> unmatched_paths;
};

// One track's metadata update in a `batch_update_database_records`
// call. `track_path` is the Serato-relative `pfil` path to match;
// `update` carries the field-by-field patch. The batch twin of
// `SeratoPathRename`.
dictionary SeratoTrackMetadataUpdate {
  string track_path;
  SeratoMetadataUpdate update;
};

// Full track-level metadata extracted from a Serato `database V2`
// entry. `path` is required (an otrk without `pfil` is useless and
// gets dropped before the FFI boundary); every other field is
// present when the corresponding `t*` tag exists in the otrk and
// decodes as valid UTF-16BE.
//
// `bpm`, `length` and other numeric-ish fields are exposed as
// strings because Serato stores them as strings (e.g. "128.000",
// "03:24"). Lossless on the FFI boundary; callers parse as needed.
dictionary SeratoTrackRecord {
  string path;
  string? artist;
  string? title;
  string? album;
  string? genre;
  string? bpm;
  string? key;
  string? comment;
  string? length;
  string? label;
};

// Field-by-field update payload for `update_database_record`. Each
// field is independently optional: `null` means "leave the existing
// tag alone"; a value means "set the tag to this value (creating
// it if absent)". An empty string writes a blank field; truly
// deleting a tag is not supported (Serato handles blank fields fine
// and that's the common case).
dictionary SeratoMetadataUpdate {
  string? artist;
  string? title;
  string? album;
  string? genre;
  string? bpm;
  string? key;
  string? comment;
  string? length;
  string? label;
};

// Patch applied to an audio file's primary tag by
// `write_audio_tags`. Mirrors `SeratoMetadata` field-for-field so
// the hygiene runner passes the merged snapshot through verbatim.
// `musical_key` becomes ID3v2 TKEY / Vorbis comment INITIALKEY;
// `label` becomes ID3v2 TPUB / Vorbis comment LABEL. `length` is
// accepted for symmetry but isn't written today (ID3v2 TLEN
// expects milliseconds, not Serato's "MM:SS" string).
dictionary AudioTagUpdate {
  string? artist;
  string? title;
  string? album;
  string? genre;
  string? bpm;
  string? musical_key;
  string? comment;
  string? label;
  u32? year;
  // `year` cannot express "clear": null means leave-unchanged. This
  // flag removes the file's date frame outright (used by MusicBrainz
  // undo when the match added a year to a previously-yearless file).
  // Takes precedence over `year`.
  boolean clear_year = false;
};

dictionary AudioTags {
  u32? bitrate_kbps;
  string? title;
  string? artist;
  string? album;
  string? album_artist;
  string? genre;
  u32? year;
  u32? track_number;
  u32? total_tracks;
  f64? bpm;
  string? comment;
  u64? duration_seconds;
};

// Strongly-typed error surface for Rust → Swift error propagation.
// `interface`-style errors carry per-variant data, so error messages
// survive the FFI boundary instead of being reduced to a bare name.
[Error]
interface CoreError {
  NotImplemented();
  InvalidInput(string reason);
  IoError(string message);
  SeratoFormat(string message);
  Fingerprint(string message);
  Tag(string message);
};
